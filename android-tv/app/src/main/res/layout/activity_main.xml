<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FF0E1116">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="#FFFFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/subtitle"
            android:textColor="#FF9CA3AF"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/form"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Local network (server-less) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/lan_title"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/lan_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/lan_none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/lan_none"
                android:textColor="#FF9CA3AF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/lan_refresh"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_bg"
                android:text="@string/lan_refresh"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/manual"
                style="@style/Field"
                android:hint="@string/lan_manual_hint"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:inputType="textUri"
                android:nextFocusDown="@+id/manual_connect" />

            <Button
                android:id="@+id/manual_connect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/btn_bg"
                android:text="@string/lan_connect"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <!-- Through the server (optional) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/server_section"
                android:textColor="#FF9CA3AF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/server"
                style="@style/Field"
                android:hint="@string/hint_server"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="textUri"
                android:nextFocusDown="@+id/code" />

            <EditText
                android:id="@+id/code"
                style="@style/Field"
                android:hint="@string/hint_code"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:nextFocusDown="@+id/connect" />

            <Button
                android:id="@+id/connect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/btn_bg"
                android:text="@string/connect"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="start"
                android:textColor="#FFF87171"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
