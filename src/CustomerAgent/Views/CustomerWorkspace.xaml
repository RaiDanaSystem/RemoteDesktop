<UserControl x:Class="CustomerAgent.Views.CustomerWorkspace"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{Binding LayoutDirection}"
        Background="{StaticResource Brush.Bg}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#042F2E" Offset="0"/>
                    <GradientStop Color="#0B1A2E" Offset="0.55"/>
                    <GradientStop Color="#070B14" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Ellipse Width="280" Height="280" Fill="#14B8A6" Opacity="0.08"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-80,-60,0,0"/>
                <Ellipse Width="220" Height="220" Fill="#22D3EE" Opacity="0.07"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-70,-50"/>
                <StackPanel VerticalAlignment="Center" Margin="48,40">
                    <Border Width="52" Height="52" CornerRadius="14" ClipToBounds="True" Margin="0,0,0,20"
                            HorizontalAlignment="Left">
                        <Image Source="/CustomerAgent;component/Resources/rexon-icon.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding AppTitle}" FontSize="28" FontWeight="SemiBold"
                               Foreground="White" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding BrandTagline}" FontSize="15" Foreground="#94A3B8"
                               TextWrapping="Wrap" LineHeight="22"/>
                    <StackPanel Orientation="Horizontal" Margin="0,32,0,0">
                        <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding ConnectionStatusColor}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatusText}" Foreground="#CBD5E1"
                                   FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource Brush.Surface}">
            <Grid Margin="40,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,20">
                    <Button DockPanel.Dock="Right" Content="{Binding LanguageButton}"
                            Style="{StaticResource Btn.Ghost}" Command="{Binding ToggleLanguageCommand}"/>
                    <TextBlock Text="{Binding SupportIdLabel}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Grid.Row="1">
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding ShowActiveSessionPanel, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Border Background="{StaticResource Brush.Surface2}" CornerRadius="16"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="28,24">
                            <StackPanel>
                                <TextBlock Text="{Binding SupportCode}" FontSize="40" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas, Courier New"/>
                                <TextBlock Text="{Binding ShareCodeInstruction}" Foreground="{StaticResource Brush.Muted}"
                                           FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding CodeExpiry}" Foreground="{StaticResource Brush.Faint}"
                                           FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,16"
                                           Visibility="{Binding IsCodeActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Content="{Binding RefreshCodeButton}" Style="{StaticResource Btn.Primary}"
                                        Command="{Binding GenerateSupportCodeCommand}" Height="44"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Background="{StaticResource Brush.Surface2}" CornerRadius="16"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="22"
                            Visibility="{Binding ShowActiveSessionPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="#14332F" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="{StaticResource Brush.Success}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ActiveSessionLabel}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Success}" FontSize="14"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SupportActiveWarning}" Foreground="#99F6E4"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding ConnectedToFormatted}" Foreground="{StaticResource Brush.Text}"
                                           FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SessionDuration}" Foreground="{StaticResource Brush.Faint}"
                                           FontSize="12" Margin="0,0,0,14"/>

                                <CheckBox Content="{Binding AllowRemoteLabel}" IsChecked="{Binding AllowRemoteControl}"
                                          Style="{StaticResource Chk.Modern}" Margin="0,0,0,8"/>
                                <CheckBox Content="{Binding AllowClipboardLabel}" IsChecked="{Binding AllowClipboard}"
                                          Style="{StaticResource Chk.Modern}" Margin="0,0,0,8"/>
                                <CheckBox Content="{Binding AllowFilesLabel}" IsChecked="{Binding AllowFileTransfer}"
                                          Style="{StaticResource Chk.Modern}" Margin="0,0,0,12"/>

                                <Border Background="{StaticResource Brush.Bg}" CornerRadius="10" Padding="12"
                                        Visibility="{Binding ShowIncomingFile, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding IncomingFileLabel}" Foreground="{StaticResource Brush.Warn}"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding SaveFileLabel}" Command="{Binding AcceptIncomingFileCommand}"
                                                    Style="{StaticResource Btn.Primary}" Margin="0,0,8,0" Padding="14,8"/>
                                            <Button Content="{Binding RejectFileLabel}" Command="{Binding RejectIncomingFileCommand}"
                                                    Style="{StaticResource Btn.Danger}" Padding="14,8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Button Content="{Binding DisconnectButton}" Style="{StaticResource Btn.Danger}"
                                        Command="{Binding DisconnectCommand}" Height="42" Margin="0,8,0,0" FontSize="14"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Border Grid.ColumnSpan="2" Background="#CC070B14"
                Visibility="{Binding ShowConnectionRequest, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{StaticResource Brush.Surface}" CornerRadius="16" Padding="28" Width="420"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ConnectionRequestTitle}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Border Background="{StaticResource Brush.Surface2}" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding RequestingAgentName}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RequestingAgentRole}" FontSize="13"
                                       Foreground="{StaticResource Brush.Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding AgentWantsToConnectText}" Foreground="{StaticResource Brush.Muted}"
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding SeeScreenLabel}" Foreground="{StaticResource Brush.Warn}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding AcceptButton}" Style="{StaticResource Btn.Primary}"
                                Command="{Binding AcceptConnectionCommand}" Height="44"/>
                        <Button Grid.Column="2" Content="{Binding RejectButton}" Style="{StaticResource Btn.Danger}"
                                Command="{Binding RejectConnectionCommand}" Height="44" FontSize="14"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
