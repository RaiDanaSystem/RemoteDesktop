<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- Login -->
    <system:String x:Key="Login_Title">Rexon</system:String>
    <system:String x:Key="Login_BrandTagline">Secure remote assistance — connect, see their screen, and help in real time.</system:String>
    <system:String x:Key="Login_Username">Username</system:String>
    <system:String x:Key="Login_Password">Password</system:String>
    <system:String x:Key="Login_Server">Server URL</system:String>
    <system:String x:Key="Login_RememberMe">Remember me</system:String>
    <system:String x:Key="Login_Button">Sign In</system:String>
    <system:String x:Key="Login_ForgotPassword">Forgot password?</system:String>
    <system:String x:Key="Login_Validation_Error">Please enter both username and password.</system:String>
    <system:String x:Key="Login_Failed">Login failed. Please check your credentials.</system:String>
    <system:String x:Key="Login_Error_Generic">An error occurred. Please try again.</system:String>

    <!-- Dashboard -->
    <system:String x:Key="Dashboard_Welcome">Welcome, {0}</system:String>
    <system:String x:Key="Dashboard_Logout">Sign Out</system:String>
    <system:String x:Key="Dashboard_Connect">Connect</system:String>
    <system:String x:Key="Dashboard_SupportCode">Customer Support ID</system:String>
    <system:String x:Key="Dashboard_ActiveSessions">Active Sessions</system:String>
    <system:String x:Key="Dashboard_Settings">Settings</system:String>
    <system:String x:Key="Dashboard_Connecting">Connecting...</system:String>
    <system:String x:Key="Dashboard_Connected">Connected</system:String>
    <system:String x:Key="Dashboard_Disconnected">Disconnected</system:String>
    <system:String x:Key="Dashboard_ConnectedTo">Connected to support code: {0}</system:String>
    <system:String x:Key="Dashboard_ConnectFailed">Failed to connect. Please try again.</system:String>
    <system:String x:Key="Dashboard_EnterCode">Please enter a customer support code.</system:String>
    <system:String x:Key="Dashboard_NoSessions">No active sessions</system:String>
    <system:String x:Key="Dashboard_CodePlaceholder">Customer support ID</system:String>
    <system:String x:Key="Dashboard_ConnectHint">Paste the code shown on the customer app</system:String>

    <!-- Session UI -->
    <system:String x:Key="Session_IdleTitle">Waiting for a session</system:String>
    <system:String x:Key="Session_IdleHint">Enter the customer support ID in the bar above, then connect.</system:String>
    <system:String x:Key="Session_ConnectingScreen">Connecting to remote screen…</system:String>
    <system:String x:Key="Session_Monitor">Monitor</system:String>
    <system:String x:Key="Session_Fullscreen">Fullscreen</system:String>
    <system:String x:Key="Session_FullscreenBanner">Remote fullscreen — mouse and keyboard control this PC. Press Esc or Exit to leave.</system:String>
    <system:String x:Key="Session_ExitFullscreen">Exit fullscreen</system:String>
    <system:String x:Key="Session_FitToScreen">Fit to Screen</system:String>
    <system:String x:Key="Session_ActualSize">Actual Size</system:String>
    <system:String x:Key="Session_MouseControl">Mouse Control</system:String>
    <system:String x:Key="Session_ShowRemoteCursor">Show remote cursor</system:String>
    <system:String x:Key="Session_KeyboardControl">Keyboard Control</system:String>
    <system:String x:Key="Session_Clipboard">Clipboard</system:String>
    <system:String x:Key="Session_Audio">Audio</system:String>
    <system:String x:Key="Session_Mute">Mute</system:String>
    <system:String x:Key="Session_Unmute">Unmute</system:String>
    <system:String x:Key="Session_Chat">Chat</system:String>
    <system:String x:Key="Session_ChatPlaceholder">Type a message...</system:String>
    <system:String x:Key="Session_Send">Send</system:String>
    <system:String x:Key="Session_Disconnect">Disconnect</system:String>
    <system:String x:Key="Session_Timer">Duration: {0}</system:String>
    <system:String x:Key="Session_FPS">FPS: {0}</system:String>
    <system:String x:Key="Session_Bitrate">Bitrate: {0} kbps</system:String>
    <system:String x:Key="Session_Latency">Latency: {0}ms</system:String>
    <system:String x:Key="Session_DroppedFrames">Dropped: {0}</system:String>
    <system:String x:Key="Session_Quality">Connection Quality</system:String>
    <system:String x:Key="Session_StreamFps">FPS</system:String>
    <system:String x:Key="Session_StreamQuality">Quality</system:String>
    <system:String x:Key="Session_Start">Start Session</system:String>
    <system:String x:Key="Session_Stop">Stop Session</system:String>
    <system:String x:Key="Session_FileTransfer">File Transfer</system:String>
    <system:String x:Key="Session_Upload">Upload File</system:String>
    <system:String x:Key="Session_Download">Download File</system:String>
    <system:String x:Key="Session_Volume">Volume</system:String>

    <!-- Customer Session UI -->
    <system:String x:Key="Customer_ActiveSession">Active Support Session</system:String>
    <system:String x:Key="Customer_ScreenSharing">Screen sharing is active</system:String>
    <system:String x:Key="Customer_RemoteControl">Remote control is {0}</system:String>
    <system:String x:Key="Customer_ClipboardAccess">Clipboard access: {0}</system:String>
    <system:String x:Key="Customer_FileTransfer">File transfer: {0}</system:String>
    <system:String x:Key="Customer_AudioAccess">Audio: {0}</system:String>
    <system:String x:Key="Customer_EndSession">End Session</system:String>
    <system:String x:Key="Customer_ConnectedTo">Connected to: {0}</system:String>
    <system:String x:Key="Customer_BrandTagline">Share this ID with your support agent so they can connect to your screen securely.</system:String>
    <system:String x:Key="Customer_SupportId">Your Support ID</system:String>
    <system:String x:Key="Customer_ShareCode">Share this code with our support team</system:String>
    <system:String x:Key="Customer_Expires">Expires</system:String>
    <system:String x:Key="Customer_ExpiresIn">Expires in {0} min</system:String>
    <system:String x:Key="Customer_RefreshCode">Get New Code</system:String>
    <system:String x:Key="Customer_WaitingForAgent">Waiting for support agent...</system:String>
    <system:String x:Key="Customer_Offline">Offline</system:String>
    <system:String x:Key="Customer_CodeFailed">Failed to generate support code.</system:String>
    <system:String x:Key="Customer_Error_Generic">An error occurred. Please try again.</system:String>
    <system:String x:Key="Customer_ConnRequestTitle">Incoming Support Request</system:String>
    <system:String x:Key="Customer_AgentWantsToConnect">{0} wants to connect to your computer</system:String>
    <system:String x:Key="Customer_Accept">Accept</system:String>
    <system:String x:Key="Customer_Reject">Reject</system:String>
    <system:String x:Key="Customer_AcceptFailed">Failed to accept connection.</system:String>
    <system:String x:Key="Customer_ConnectedToAgent">Connected to support agent</system:String>
    <system:String x:Key="Customer_Disconnect">End Session</system:String>
    <system:String x:Key="Customer_SupportActive">Remote support is active</system:String>
    <system:String x:Key="Customer_SupportActiveWarning">A support agent has access to your screen</system:String>
    <system:String x:Key="Customer_AllowRemote">Allow mouse and keyboard</system:String>
    <system:String x:Key="Customer_AllowClipboard">Allow clipboard sync</system:String>
    <system:String x:Key="Customer_AllowFiles">Allow file transfer</system:String>
    <system:String x:Key="Customer_IncomingFile">Incoming file: {0}</system:String>
    <system:String x:Key="Customer_SaveFile">Save</system:String>
    <system:String x:Key="Customer_RejectFile">Reject</system:String>
    <system:String x:Key="Customer_SeeScreen">They will be able to see your screen</system:String>

    <!-- Shell -->
    <system:String x:Key="Shell_AppTitle">Rexon</system:String>
    <system:String x:Key="Shell_Headline">Choose how you want to work</system:String>
    <system:String x:Key="Shell_Subhead">One app for both roles. Pick support or customer — only one mode is active in this window. Run the app twice to test both sides.</system:String>
    <system:String x:Key="Shell_SupportTitle">I am the support agent</system:String>
    <system:String x:Key="Shell_SupportBody">Enter a customer support ID and view their screen in real time.</system:String>
    <system:String x:Key="Shell_CustomerTitle">I need support</system:String>
    <system:String x:Key="Shell_CustomerBody">Show a code to your agent so they can connect to this computer.</system:String>
    <system:String x:Key="Shell_ServerLabel">Server address</system:String>
    <system:String x:Key="Shell_ServerHint">Saved on this PC after you save once. Used for both support and customer mode.</system:String>
    <system:String x:Key="Shell_SaveServer">Save server</system:String>
    <system:String x:Key="Shell_SettingsTitle">Server settings</system:String>
    <system:String x:Key="Shell_SettingsServerHint">Enter a new address to override. Leave empty to clear the override. The built-in default is never shown here.</system:String>
    <system:String x:Key="Shell_Back">Back</system:String>
    <system:String x:Key="Shell_ServerSaved">Server address saved.</system:String>
    <system:String x:Key="Shell_LeaveSessionTitle">Active session</system:String>
    <system:String x:Key="Shell_LeaveSessionWarning">An active session will be closed if you return to the home screen. Continue?</system:String>

    <!-- General -->
    <system:String x:Key="App_Title">Rexon</system:String>
    <system:String x:Key="Status_Ready">Ready</system:String>
    <system:String x:Key="Status_Error">Error</system:String>


    <!-- Local network (server-less) mode -->
    <system:String x:Key="Shell_LanTitle">Computers on this network</system:String>
    <system:String x:Key="Shell_LanBody">No server needed. See other computers running this app on your local network and connect directly.</system:String>
    <system:String x:Key="Lan_ShareToggle">Let other computers on this network request to view “{0}”</system:String>
    <system:String x:Key="Lan_Computers">Computers on this network</system:String>
    <system:String x:Key="Lan_None">No computers found yet. Make sure the app is open on the other PC and both are on the same network, or type its address below.</system:String>
    <system:String x:Key="Lan_Refresh">Refresh</system:String>
    <system:String x:Key="Lan_ManualHint">Or type an IP address (e.g. 192.168.1.20)</system:String>
    <system:String x:Key="Lan_BadAddress">That address could not be understood.</system:String>
    <system:String x:Key="Lan_WaitingAccept">Waiting for {0} to accept the connection…</system:String>
    <system:String x:Key="Lan_IncomingTitle">Connection request</system:String>
    <system:String x:Key="Lan_IncomingBody">“{0}” ({1}) wants to see this computer.&#10;&#10;Yes = view and control&#10;No = view only&#10;Cancel = deny</system:String>
    <system:String x:Key="Lan_Banner">“{0}” is viewing and controlling this computer.</system:String>
    <system:String x:Key="Lan_BannerViewOnly">“{0}” is viewing this computer (view only).</system:String>
    <system:String x:Key="Lan_StopSharing">Stop sharing</system:String>
    <system:String x:Key="Lan_StartFailed">Local network mode could not start.</system:String>
    <system:String x:Key="Session_StreamResolution">Resolution</system:String>

    <system:String x:Key="Lan_RequestTitle">Connection request</system:String>
    <system:String x:Key="Lan_RequestText">wants to connect to this computer.</system:String>
    <system:String x:Key="Lan_SeeScreen">They will be able to see your screen</system:String>
    <system:String x:Key="Lan_AcceptControl">Accept (view &amp; control)</system:String>
    <system:String x:Key="Lan_ViewOnly">View only</system:String>
    <system:String x:Key="Lan_Reject">Reject</system:String>
    <system:String x:Key="Lan_Disconnect">Disconnect</system:String>
    <system:String x:Key="Session_Sound">Sound</system:String>
    <system:String x:Key="Sound_Off">Off</system:String>
    <system:String x:Key="Sound_Here">Play here</system:String>
    <system:String x:Key="Sound_HereMute">Play here, mute remote PC</system:String>
</ResourceDictionary>
