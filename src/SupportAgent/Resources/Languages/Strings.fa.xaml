<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- Login -->
    <system:String x:Key="Login_Title">Rexon</system:String>
    <system:String x:Key="Login_BrandTagline">پشتیبانی امن از راه دور — به صفحه مشتری وصل شوید و در لحظه کمک کنید.</system:String>
    <system:String x:Key="Login_Username">نام کاربری</system:String>
    <system:String x:Key="Login_Password">رمز عبور</system:String>
    <system:String x:Key="Login_Server">آدرس سرور</system:String>
    <system:String x:Key="Login_RememberMe">مرا به خاطر بسپار</system:String>
    <system:String x:Key="Login_Button">ورود</system:String>
    <system:String x:Key="Login_ForgotPassword">رمز عبور را فراموش کرده‌اید؟</system:String>
    <system:String x:Key="Login_Validation_Error">لطفاً نام کاربری و رمز عبور را وارد کنید.</system:String>
    <system:String x:Key="Login_Failed">ورود ناموفق بود. لطفاً اطلاعات خود را بررسی کنید.</system:String>
    <system:String x:Key="Login_Error_Generic">خطایی رخ داد. لطفاً دوباره تلاش کنید.</system:String>

    <!-- Dashboard -->
    <system:String x:Key="Dashboard_Welcome">خوش آمدید، {0}</system:String>
    <system:String x:Key="Dashboard_Logout">خروج</system:String>
    <system:String x:Key="Dashboard_Connect">اتصال</system:String>
    <system:String x:Key="Dashboard_SupportCode">کد پشتیبانی مشتری</system:String>
    <system:String x:Key="Dashboard_ActiveSessions">جلسات فعال</system:String>
    <system:String x:Key="Dashboard_Settings">تنظیمات</system:String>
    <system:String x:Key="Dashboard_Connecting">در حال اتصال...</system:String>
    <system:String x:Key="Dashboard_Connected">متصل شد</system:String>
    <system:String x:Key="Dashboard_Disconnected">قطع شد</system:String>
    <system:String x:Key="Dashboard_ConnectedTo">متصل به کد پشتیبانی: {0}</system:String>
    <system:String x:Key="Dashboard_ConnectFailed">اتصال ناموفق بود. لطفاً دوباره تلاش کنید.</system:String>
    <system:String x:Key="Dashboard_EnterCode">لطفاً کد پشتیبانی مشتری را وارد کنید.</system:String>
    <system:String x:Key="Dashboard_NoSessions">جلسه فعالی وجود ندارد</system:String>
    <system:String x:Key="Dashboard_CodePlaceholder">کد پشتیبانی مشتری</system:String>
    <system:String x:Key="Dashboard_ConnectHint">کدی که در برنامه مشتری نمایش داده می‌شود را وارد کنید</system:String>

    <!-- Session UI -->
    <system:String x:Key="Session_IdleTitle">در انتظار جلسه</system:String>
    <system:String x:Key="Session_IdleHint">کد پشتیبانی مشتری را در نوار بالا وارد کنید و اتصال را بزنید.</system:String>
    <system:String x:Key="Session_ConnectingScreen">در حال اتصال به صفحه از راه دور…</system:String>
    <system:String x:Key="Session_Monitor">مانیتور</system:String>
    <system:String x:Key="Session_Fullscreen">تمام صفحه</system:String>
    <system:String x:Key="Session_FullscreenBanner">تمام‌صفحه ریموت — موس و کیبورد این رایانه را کنترل می‌کنند. برای خروج Esc یا دکمه خروج را بزنید.</system:String>
    <system:String x:Key="Session_ExitFullscreen">خروج از تمام‌صفحه</system:String>
    <system:String x:Key="Session_FitToScreen">متناسب با صفحه</system:String>
    <system:String x:Key="Session_ActualSize">اندازه واقعی</system:String>
    <system:String x:Key="Session_MouseControl">کنترل ماوس</system:String>
    <system:String x:Key="Session_ShowRemoteCursor">نمایش موس ریموت</system:String>
    <system:String x:Key="Session_KeyboardControl">کنترل صفحه کلید</system:String>
    <system:String x:Key="Session_Clipboard">کلیپ‌بورد</system:String>
    <system:String x:Key="Session_Audio">صدا</system:String>
    <system:String x:Key="Session_Mute">بی‌صدا</system:String>
    <system:String x:Key="Session_Unmute">صدادار</system:String>
    <system:String x:Key="Session_Chat">گفتگو</system:String>
    <system:String x:Key="Session_ChatPlaceholder">پیام خود را تایپ کنید...</system:String>
    <system:String x:Key="Session_Send">ارسال</system:String>
    <system:String x:Key="Session_Disconnect">قطع اتصال</system:String>
    <system:String x:Key="Session_Timer">مدت زمان: {0}</system:String>
    <system:String x:Key="Session_FPS">فریم بر ثانیه: {0}</system:String>
    <system:String x:Key="Session_Bitrate">نرخ بیت: {0} کیلوبیت</system:String>
    <system:String x:Key="Session_Latency">تأخیر: {0} میلی‌ثانیه</system:String>
    <system:String x:Key="Session_DroppedFrames">فریم‌های از دست رفته: {0}</system:String>
    <system:String x:Key="Session_Quality">کیفیت اتصال</system:String>
    <system:String x:Key="Session_StreamFps">فریم</system:String>
    <system:String x:Key="Session_StreamQuality">کیفیت</system:String>
    <system:String x:Key="Session_Start">شروع جلسه</system:String>
    <system:String x:Key="Session_Stop">پایان جلسه</system:String>
    <system:String x:Key="Session_FileTransfer">انتقال فایل</system:String>
    <system:String x:Key="Session_Upload">آپلود فایل</system:String>
    <system:String x:Key="Session_Download">دانلود فایل</system:String>
    <system:String x:Key="Session_Volume">صدا</system:String>

    <!-- Customer Session UI -->
    <system:String x:Key="Customer_ActiveSession">جلسه پشتیبانی فعال</system:String>
    <system:String x:Key="Customer_ScreenSharing">اشتراک‌گذاری صفحه فعال است</system:String>
    <system:String x:Key="Customer_RemoteControl">کنترل از راه دور: {0}</system:String>
    <system:String x:Key="Customer_ClipboardAccess">دسترسی کلیپ‌بورد: {0}</system:String>
    <system:String x:Key="Customer_FileTransfer">انتقال فایل: {0}</system:String>
    <system:String x:Key="Customer_AudioAccess">صدا: {0}</system:String>
    <system:String x:Key="Customer_EndSession">پایان جلسه</system:String>
    <system:String x:Key="Customer_ConnectedTo">متصل به: {0}</system:String>
    <system:String x:Key="Customer_BrandTagline">این شناسه را با کارشناس پشتیبانی به اشتراک بگذارید تا به‌صورت امن به صفحه شما وصل شود.</system:String>
    <system:String x:Key="Customer_SupportId">کد پشتیبانی شما</system:String>
    <system:String x:Key="Customer_ShareCode">این کد را با تیم پشتیبانی ما به اشتراک بگذارید</system:String>
    <system:String x:Key="Customer_Expires">انقضا</system:String>
    <system:String x:Key="Customer_ExpiresIn">منقضی می‌شود در {0} دقیقه</system:String>
    <system:String x:Key="Customer_RefreshCode">دریافت کد جدید</system:String>
    <system:String x:Key="Customer_WaitingForAgent">در انتظار عامل پشتیبانی...</system:String>
    <system:String x:Key="Customer_Offline">آفلاین</system:String>
    <system:String x:Key="Customer_CodeFailed">دریافت کد پشتیبانی ناموفق بود.</system:String>
    <system:String x:Key="Customer_Error_Generic">خطایی رخ داد. لطفاً دوباره تلاش کنید.</system:String>
    <system:String x:Key="Customer_ConnRequestTitle">درخواست پشتیبانی ورودی</system:String>
    <system:String x:Key="Customer_AgentWantsToConnect">{0} می‌خواهد به رایانه شما متصل شود</system:String>
    <system:String x:Key="Customer_Accept">پذیرش</system:String>
    <system:String x:Key="Customer_Reject">رد</system:String>
    <system:String x:Key="Customer_AcceptFailed">پذیرش اتصال ناموفق بود.</system:String>
    <system:String x:Key="Customer_ConnectedToAgent">متصل به عامل پشتیبانی</system:String>
    <system:String x:Key="Customer_Disconnect">پایان جلسه</system:String>
    <system:String x:Key="Customer_SupportActive">پشتیبانی از راه دور فعال است</system:String>
    <system:String x:Key="Customer_SupportActiveWarning">یک عامل پشتیبانی به صفحه شما دسترسی دارد</system:String>
    <system:String x:Key="Customer_AllowRemote">اجازه ماوس و صفحه‌کلید</system:String>
    <system:String x:Key="Customer_AllowClipboard">همگام‌سازی کلیپ‌بورد</system:String>
    <system:String x:Key="Customer_AllowFiles">انتقال فایل</system:String>
    <system:String x:Key="Customer_IncomingFile">فایل ورودی: {0}</system:String>
    <system:String x:Key="Customer_SaveFile">ذخیره</system:String>
    <system:String x:Key="Customer_RejectFile">رد</system:String>
    <system:String x:Key="Customer_SeeScreen">آن‌ها صفحه شما را خواهند دید</system:String>

    <!-- Shell -->
    <system:String x:Key="Shell_AppTitle">Rexon</system:String>
    <system:String x:Key="Shell_Headline">نقش خود را انتخاب کنید</system:String>
    <system:String x:Key="Shell_Subhead">یک برنامه برای هر دو نقش. ساپورت یا مشتری را انتخاب کنید — در این پنجره فقط یک مود فعال است. برای تست هر دو طرف، برنامه را دو بار اجرا کنید.</system:String>
    <system:String x:Key="Shell_SupportTitle">عامل پشتیبانی هستم</system:String>
    <system:String x:Key="Shell_SupportBody">کد پشتیبانی مشتری را وارد کنید و صفحه او را ببینید.</system:String>
    <system:String x:Key="Shell_CustomerTitle">به پشتیبانی نیاز دارم</system:String>
    <system:String x:Key="Shell_CustomerBody">یک کد به کارشناس نشان دهید تا به این رایانه وصل شود.</system:String>
    <system:String x:Key="Shell_ServerLabel">آدرس سرور</system:String>
    <system:String x:Key="Shell_ServerHint">پس از یک‌بار ذخیره، روی این رایانه باقی می‌ماند و برای هر دو مود استفاده می‌شود.</system:String>
    <system:String x:Key="Shell_SaveServer">ذخیره سرور</system:String>
    <system:String x:Key="Shell_SettingsTitle">تنظیمات سرور</system:String>
    <system:String x:Key="Shell_SettingsServerHint">آدرس جدید را وارد کنید. خالی بگذارید تا جایگزینی پاک شود. آدرس پیش‌فرض داخل برنامه اینجا نمایش داده نمی‌شود.</system:String>
    <system:String x:Key="Shell_Back">بازگشت</system:String>
    <system:String x:Key="Shell_ServerSaved">آدرس سرور ذخیره شد.</system:String>
    <system:String x:Key="Shell_LeaveSessionTitle">جلسه فعال</system:String>
    <system:String x:Key="Shell_LeaveSessionWarning">اگر به صفحه اصلی برگردید جلسه فعال بسته می‌شود. ادامه می‌دهید؟</system:String>

    <!-- General -->
    <system:String x:Key="App_Title">Rexon</system:String>
    <system:String x:Key="Status_Ready">آماده</system:String>
    <system:String x:Key="Status_Error">خطا</system:String>


    <!-- Local network (server-less) mode -->
    <system:String x:Key="Shell_LanTitle">رایانه‌های این شبکه</system:String>
    <system:String x:Key="Shell_LanBody">بدون نیاز به سرور. رایانه‌های دیگری را که این برنامه را در شبکه محلی اجرا کرده‌اند ببینید و مستقیم وصل شوید.</system:String>
    <system:String x:Key="Lan_ShareToggle">اجازه بده رایانه‌های دیگر این شبکه درخواست دیدن «{0}» را بدهند</system:String>
    <system:String x:Key="Lan_Computers">رایانه‌های این شبکه</system:String>
    <system:String x:Key="Lan_None">هنوز رایانه‌ای پیدا نشد. مطمئن شوید برنامه روی رایانه‌ی دیگر باز است و هر دو در یک شبکه‌اند، یا آدرس آن را پایین وارد کنید.</system:String>
    <system:String x:Key="Lan_Refresh">بازخوانی</system:String>
    <system:String x:Key="Lan_ManualHint">یا آدرس IP را بنویسید (مثلاً 192.168.1.20)</system:String>
    <system:String x:Key="Lan_BadAddress">این آدرس قابل فهم نبود.</system:String>
    <system:String x:Key="Lan_WaitingAccept">منتظر تأیید {0} هستیم…</system:String>
    <system:String x:Key="Lan_IncomingTitle">درخواست اتصال</system:String>
    <system:String x:Key="Lan_IncomingBody">«{0}» ({1}) می‌خواهد این رایانه را ببیند.&#10;&#10;بله = دیدن و کنترل&#10;خیر = فقط دیدن&#10;انصراف = رد درخواست</system:String>
    <system:String x:Key="Lan_Banner">«{0}» در حال دیدن و کنترل این رایانه است.</system:String>
    <system:String x:Key="Lan_BannerViewOnly">«{0}» در حال دیدن این رایانه است (فقط مشاهده).</system:String>
    <system:String x:Key="Lan_StopSharing">توقف اشتراک</system:String>
    <system:String x:Key="Lan_StartFailed">حالت شبکه محلی راه‌اندازی نشد.</system:String>
    <system:String x:Key="Session_StreamResolution">وضوح</system:String>

    <system:String x:Key="Lan_RequestTitle">درخواست اتصال</system:String>
    <system:String x:Key="Lan_RequestText">می‌خواهد به این رایانه وصل شود.</system:String>
    <system:String x:Key="Lan_SeeScreen">او می‌تواند صفحه‌ی شما را ببیند</system:String>
    <system:String x:Key="Lan_AcceptControl">قبول (مشاهده و کنترل)</system:String>
    <system:String x:Key="Lan_ViewOnly">فقط مشاهده</system:String>
    <system:String x:Key="Lan_Reject">رد کردن</system:String>
    <system:String x:Key="Lan_Disconnect">قطع اتصال</system:String>
</ResourceDictionary>
