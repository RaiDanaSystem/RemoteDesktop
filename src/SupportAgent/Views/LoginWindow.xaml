<Window x:Class="SupportAgent.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding LoginTitle}"
        Height="640" Width="980"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        FlowDirection="{Binding LayoutDirection}"
        Background="{StaticResource Brush.Bg}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="10,6,0,6" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Caption}" Click="Minimize_Click">
                        <Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Data="M0,8 L10,8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button Style="{StaticResource Btn.CaptionClose}" Click="Close_Click">
                        <Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Data="M1,1 L9,9 M9,1 L1,9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" ClipToBounds="True">
                        <Image Source="/SupportAgent;component/Resources/rexon-icon.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="Rexon" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0"
                               Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#042F2E" Offset="0"/>
                    <GradientStop Color="#0B1A2E" Offset="0.55"/>
                    <GradientStop Color="#070B14" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Ellipse Width="280" Height="280" Fill="#14B8A6" Opacity="0.08"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-80,-60,0,0"/>
                <Ellipse Width="220" Height="220" Fill="#22D3EE" Opacity="0.07"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-70,-50"/>
                <StackPanel VerticalAlignment="Center" Margin="48,40">
                    <Border Width="52" Height="52" CornerRadius="14" ClipToBounds="True" Margin="0,0,0,20"
                            HorizontalAlignment="Left">
                        <Image Source="/SupportAgent;component/Resources/rexon-icon.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding LoginTitle}" FontSize="28" FontWeight="SemiBold"
                               Foreground="White" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding BrandTagline}" FontSize="15" Foreground="#94A3B8"
                               TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource Brush.Surface}" Padding="48,40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,28">
                    <Button DockPanel.Dock="Right" Content="{Binding LanguageButton}"
                            Style="{StaticResource Btn.Ghost}" Command="{Binding ToggleLanguageCommand}"/>
                    <TextBlock Text="{Binding LoginSubtitle}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
                </DockPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="{Binding UsernameLabel}" Foreground="{StaticResource Brush.Muted}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding PasswordLabel}" Foreground="{StaticResource Brush.Muted}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource FieldPassword}"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 Margin="0,0,0,16"/>

                    <CheckBox Content="{Binding RememberMeLabel}" Style="{StaticResource Chk.Modern}"
                              IsChecked="{Binding RememberMe}" Margin="0,0,0,24"/>

                    <Button Content="{Binding LoginButton}" Style="{StaticResource Btn.Primary}"
                            Click="LoginButton_Click" Height="46" Margin="0,0,0,12"/>

                    <ProgressBar IsIndeterminate="True" Height="3" Foreground="{StaticResource Brush.Primary}"
                                 Background="Transparent" BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.Danger}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <Border Grid.Row="2" Background="{StaticResource Brush.Surface2}" CornerRadius="12" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding ServerStatusColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ServerStatus}" Foreground="{StaticResource Brush.Text}" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ServerStatusDetail}" Foreground="{StaticResource Brush.Faint}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
