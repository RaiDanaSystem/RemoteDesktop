<Window x:Class="SupportAgent.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:session="clr-namespace:SupportAgent.Views.Session"
        Title="{Binding AppTitle}" Height="820" Width="1280"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding LayoutDirection}"
        Background="{StaticResource Brush.Bg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" ClipToBounds="True">
                        <Image Source="/RexonRemote;component/Resources/rexon-icon.png" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Margin="12,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppTitle}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource Brush.Text}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource Brush.Faint}">
                            <Run Text="{Binding CurrentSession.DisplayName, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding UserRole, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" MaxWidth="560" HorizontalAlignment="Stretch" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Style="{StaticResource FieldBox}" Padding="14,10"
                                 Text="{Binding SupportCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15" FontWeight="SemiBold" VerticalContentAlignment="Center"/>
                        <TextBlock Text="{Binding SupportCodePlaceholder}" IsHitTestVisible="False"
                                   Foreground="{StaticResource Brush.Faint}" FontSize="13"
                                   Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SupportCodeInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="1" Content="{Binding ConnectButton}" Style="{StaticResource Btn.Primary}"
                            Command="{Binding ConnectCommand}" Margin="10,0,0,0" MinWidth="108" Padding="16,10"/>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding ConnectionStatusColor}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource Brush.Muted}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="{Binding LanguageButton}" Style="{StaticResource Btn.Ghost}"
                            Command="{Binding ToggleLanguageCommand}"/>
                    <Button Content="{Binding LogoutButton}" Style="{StaticResource Btn.Ghost}"
                            Command="{Binding LogoutCommand}" Foreground="{StaticResource Brush.Danger}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" FontSize="12" Margin="4,0,4,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Grid.Row="1" Background="{StaticResource Brush.Surface}" CornerRadius="16"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                <session:SessionView x:Name="LiveSessionView" DataContext="{Binding SessionViewModel}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
