<UserControl x:Class="SupportAgent.Views.Session.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SupportAgent.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1220" Padding="8,4" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource Toggle.Tool}" IsChecked="{Binding IsMouseControlEnabled}" Margin="0,0,6,0"
                                  ToolTip="{Binding MouseLabel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE962;" FontFamily="{StaticResource Font.Icon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MouseLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Toggle.Tool}" IsChecked="{Binding IsKeyboardControlEnabled}" Margin="0,0,6,0"
                                  ToolTip="{Binding KeyboardLabel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource Font.Icon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding KeyboardLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Toggle.Tool}" IsChecked="{Binding IsClipboardEnabled}" Margin="0,0,6,0"
                                  ToolTip="{Binding ClipboardLabel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Font.Icon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ClipboardLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Toggle.Tool}" IsChecked="{Binding IsShowRemoteCursor}" Margin="0,0,12,0"
                                  ToolTip="{Binding RemoteCursorLabel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C8;" FontFamily="{StaticResource Font.Icon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RemoteCursorLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <Button Style="{StaticResource Btn.Tool}" Command="{Binding UploadFileCommand}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="{StaticResource Font.Icon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UploadLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Tool}" Command="{Binding ToggleFullscreenCommand}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE740;" FontFamily="{StaticResource Font.Icon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FullscreenLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding StreamFpsLabel}" Foreground="{StaticResource Brush.Muted}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding StreamFps}"
                              Style="{StaticResource Combo.Tool}"
                              Width="64" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StreamSoundLabel}" Foreground="{StaticResource Brush.Muted}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding AudioModeOptions}" SelectedIndex="{Binding StreamAudioMode}"
                              Style="{StaticResource Combo.Tool}"
                              Width="190" Margin="0,0,10,0" VerticalAlignment="Center"
                              ToolTip="Hear the remote PC here; optionally silence its own speakers"/>
                    <TextBlock Text="{Binding StreamResolutionLabel}" Foreground="{StaticResource Brush.Muted}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding StreamResolution}"
                              Style="{StaticResource Combo.Tool}"
                              Width="76" Margin="0,0,10,0" VerticalAlignment="Center"
                              ToolTip="4K needs a fast PC and network (best on a wired LAN)"/>
                    <TextBlock Text="{Binding StreamQualityLabel}" Foreground="{StaticResource Brush.Muted}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding StreamQuality}"
                              Style="{StaticResource Combo.Tool}"
                              Width="64" Margin="0,0,8,0" VerticalAlignment="Center"
                              ToolTip="25 = smoother on slow links, 75 = sharper"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource Btn.Danger}" Command="{Binding DisconnectCommand}"
                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisconnectLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#05080F">
                <Grid>
                    <Image x:Name="RemoteScreenImage"
                           Source="{Binding RemoteScreenImage}"
                           Stretch="Uniform"
                           Cursor="Arrow"
                           Focusable="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowIdleOverlay, Converter={StaticResource BoolToVis}}">
                        <Border Width="64" Height="64" CornerRadius="18" Background="#14332F" Margin="0,0,0,16"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#xE968;" FontFamily="{StaticResource Font.Icon}" FontSize="28"
                                       Foreground="{StaticResource Brush.Primary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding IdleTitle}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding IdleHint}" FontSize="13" Foreground="{StaticResource Brush.Muted}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Background="#8005080F"
                            Visibility="{Binding ShowConnectingOverlay, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="180" Height="3"
                                         Foreground="{StaticResource Brush.Primary}" Background="Transparent" BorderThickness="0"/>
                            <TextBlock Text="{Binding ConnectingScreen}" Foreground="{StaticResource Brush.Muted}"
                                       FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Width="240" Background="{StaticResource Brush.Surface2}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0"
                    Visibility="{Binding HasActiveTransfers, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="14">
                    <TextBlock Text="{Binding TransfersLabel}" Foreground="{StaticResource Brush.Text}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding ActiveTransfers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Margin="0,6,0,4"
                                                 Foreground="{StaticResource Brush.Primary}" Background="{StaticResource Brush.Border}" BorderThickness="0"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Brush.Faint}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0B1220" Padding="10,4" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding ConnectionStatusColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource Brush.Muted}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CustomerDevice}" Foreground="{StaticResource Brush.Faint}" FontSize="11"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SessionDuration}" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding FpsLabel}" Foreground="#34D399" FontSize="11" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding BitrateLabel}" Foreground="#67E8F9" FontSize="11" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding LatencyLabel}" Foreground="#FBBF24" FontSize="11" Margin="12,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
