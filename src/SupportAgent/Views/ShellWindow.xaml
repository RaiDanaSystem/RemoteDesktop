<Window x:Class="SupportAgent.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding AppTitle}"
        Height="720" Width="1100"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FlowDirection="{Binding LayoutDirection}"
        Background="{StaticResource Brush.Bg}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="10,8,0,8" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding LanguageButton}" Style="{StaticResource Btn.Ghost}"
                            Command="{Binding ToggleLanguageCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="{Binding SettingsButton}" Style="{StaticResource Btn.Ghost}"
                            Command="{Binding OpenSettingsCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource Btn.Caption}" Click="Minimize_Click" ToolTip="Minimize">
                        <Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Data="M0,8 L10,8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource Btn.Caption}" Click="Maximize_Click" ToolTip="Maximize">
                        <Grid Width="10" Height="10">
                            <Path x:Name="MaximizeGlyph" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" Fill="Transparent" Data="M1,1 H9 V9 H1 Z"/>
                            <Path x:Name="RestoreGlyph" Visibility="Collapsed" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" Fill="Transparent"
                                  Data="M3,1 H9 V7 H8 V8 H2 V2 H3 Z M2,3 H7 V8 H2 Z"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource Btn.CaptionClose}" Click="Close_Click" ToolTip="Close">
                        <Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Data="M1,1 L9,9 M9,1 L1,9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
                <Button DockPanel.Dock="Left" Content="{Binding BackButton}" Style="{StaticResource Btn.Ghost}"
                        Command="{Binding GoHomeCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" ClipToBounds="True">
                        <Image Source="/SupportAgent;component/Resources/rexon-icon.png" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppTitle}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource Brush.Text}"/>
                        <TextBlock Text="{Binding ModeTitle}" FontSize="11"
                                   Foreground="{StaticResource Brush.Faint}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Shown whenever another computer is connected to this one -->
        <Border Grid.Row="1" Background="#14332F" BorderBrush="#1F6B5E" BorderThickness="0,0,0,1" Padding="16,8"
                Visibility="{Binding LanHostingActive, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding LanDisconnectLabel}" Style="{StaticResource Btn.Danger}"
                        Command="{Binding StopLanSharingCommand}" Padding="16,6" FontSize="13"/>
                <Ellipse Width="10" Height="10" Fill="{StaticResource Brush.Success}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LanHostingText}" Foreground="#99F6E4" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#042F2E" Offset="0"/>
                            <GradientStop Color="#0B1A2E" Offset="0.55"/>
                            <GradientStop Color="#070B14" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse Width="280" Height="280" Fill="#14B8A6" Opacity="0.08"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-80,-60,0,0"/>
                        <Ellipse Width="220" Height="220" Fill="#22D3EE" Opacity="0.07"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-70,-50"/>
                        <StackPanel VerticalAlignment="Center" Margin="48,40">
                            <Border Width="52" Height="52" CornerRadius="14" ClipToBounds="True" Margin="0,0,0,20"
                                    HorizontalAlignment="Left">
                                <Image Source="/SupportAgent;component/Resources/rexon-icon.png" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding HomeHeadline}" FontSize="28" FontWeight="SemiBold"
                                       Foreground="White" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding HomeSubhead}" FontSize="15" Foreground="#94A3B8"
                                       TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource Brush.Surface}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="36,32">
                            <Button Command="{Binding EnterSupportCommand}" Cursor="Hand" Margin="0,0,0,12"
                                    HorizontalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" Background="{StaticResource Brush.Surface2}"
                                                CornerRadius="16" BorderBrush="{StaticResource Brush.Border}"
                                                BorderThickness="1" Padding="20,18">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SupportCardTitle}" FontSize="18"
                                                           FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                                                <TextBlock Text="{Binding SupportCardBody}" FontSize="13"
                                                           Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="card" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Command="{Binding EnterCustomerCommand}" Cursor="Hand" Margin="0,0,0,12"
                                    HorizontalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" Background="{StaticResource Brush.Surface2}"
                                                CornerRadius="16" BorderBrush="{StaticResource Brush.Border}"
                                                BorderThickness="1" Padding="20,18">
                                            <StackPanel>
                                                <TextBlock Text="{Binding CustomerCardTitle}" FontSize="18"
                                                           FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                                                <TextBlock Text="{Binding CustomerCardBody}" FontSize="13"
                                                           Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="card" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Command="{Binding EnterLanCommand}" Cursor="Hand" Margin="0,0,0,20"
                                    HorizontalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" Background="{StaticResource Brush.Surface2}"
                                                CornerRadius="16" BorderBrush="{StaticResource Brush.Border}"
                                                BorderThickness="1" Padding="20,18">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LanCardTitle}" FontSize="18"
                                                           FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                                                <TextBlock Text="{Binding LanCardBody}" FontSize="13"
                                                           Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="card" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <CheckBox Content="{Binding LanShareLabel}" IsChecked="{Binding LanSharingEnabled}"
                                      Foreground="{StaticResource Brush.Text}" FontSize="13" Margin="2,0,0,8"/>
                            <CheckBox IsChecked="{Binding LanMuteWhileShared}"
                                      Foreground="{StaticResource Brush.Text}" FontSize="13" Margin="2,0,0,20">
                                <TextBlock Text="{Binding LanMuteLabel}" TextWrapping="Wrap"/>
                            </CheckBox>

                            <StackPanel Visibility="{Binding ShowServerOnHome, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding ServerLabel}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding HomeServerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding ServerHint}" FontSize="12" Foreground="{StaticResource Brush.Faint}"
                                           TextWrapping="Wrap" Margin="0,8,0,12"/>
                                <Button Content="{Binding SaveServerButton}" Style="{StaticResource Btn.Primary}"
                                        Command="{Binding SaveHomeServerCommand}" Height="42"/>
                            </StackPanel>

                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Faint}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <ContentControl Content="{Binding ModeContent}"
                            Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
        </Grid>

        <Border Grid.RowSpan="3" Background="#CC070B14"
                Visibility="{Binding ShowLanRequest, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{StaticResource Brush.Surface}" CornerRadius="16" Padding="28" Width="440"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding LanRequestTitle}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Border Background="{StaticResource Brush.Surface2}" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding LanRequestName}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding LanRequestDetail}" FontSize="13"
                                       Foreground="{StaticResource Brush.Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding LanRequestText}" Foreground="{StaticResource Brush.Muted}"
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding LanSeeScreenLabel}" Foreground="{StaticResource Brush.Warn}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="{Binding LanAcceptLabel}" Style="{StaticResource Btn.Primary}"
                            Command="{Binding AcceptLanControlCommand}" Height="44" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding LanViewOnlyLabel}" Style="{StaticResource Btn.Ghost}"
                                Command="{Binding AcceptLanViewOnlyCommand}" Height="42"/>
                        <Button Grid.Column="2" Content="{Binding LanRejectLabel}" Style="{StaticResource Btn.Danger}"
                                Command="{Binding RejectLanCommand}" Height="42" FontSize="14"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.RowSpan="3" Background="#CC070B14"
                Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{StaticResource Brush.Surface}" CornerRadius="16" Padding="28" Width="440"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding SettingsTitle}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding SettingsServerHint}" FontSize="13" Foreground="{StaticResource Brush.Muted}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding SettingsServerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding SaveServerButton}" Style="{StaticResource Btn.Primary}"
                                Command="{Binding SaveSettingsServerCommand}" Height="42"/>
                        <Button Grid.Column="2" Content="{Binding BackButton}" Style="{StaticResource Btn.Ghost}"
                                Command="{Binding CloseSettingsCommand}" Height="42"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
