<UserControl x:Class="SupportAgent.Views.SupportWorkspace"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:session="clr-namespace:SupportAgent.Views.Session"
        FlowDirection="{Binding LayoutDirection}"
        Background="{StaticResource Brush.Bg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid MaxWidth="640" MinWidth="420" HorizontalAlignment="Stretch" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid MinHeight="40">
                        <TextBox Style="{StaticResource FieldBox}" Padding="12,8" MinHeight="40"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SupportCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SupportCodePlaceholder}" IsHitTestVisible="False"
                                   Foreground="{StaticResource Brush.Faint}" FontSize="13"
                                   Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SupportCodeInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="1" Content="{Binding ConnectButton}" Style="{StaticResource Btn.Primary}"
                            Command="{Binding ConnectCommand}" Margin="8,0,0,0" MinWidth="96" Padding="14,8" MinHeight="40"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding ConnectionStatusColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource Brush.Muted}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" FontSize="12" Margin="8,4,8,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Grid.Row="1" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0" ClipToBounds="True">
                <session:SessionView x:Name="LiveSessionView" DataContext="{Binding SessionViewModel}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
