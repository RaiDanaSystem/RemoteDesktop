<UserControl x:Class="SupportAgent.Views.SupportWorkspace"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:session="clr-namespace:SupportAgent.Views.Session"
        FlowDirection="{Binding LayoutDirection}"
        Background="{StaticResource Brush.Bg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid MaxWidth="640" MinWidth="420" HorizontalAlignment="Stretch" Margin="0,0,12,0"
                      Visibility="{Binding IsLanMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid MinHeight="40">
                        <TextBox Style="{StaticResource FieldBox}" Padding="12,8" MinHeight="40"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SupportCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SupportCodePlaceholder}" IsHitTestVisible="False"
                                   Foreground="{StaticResource Brush.Faint}" FontSize="13"
                                   Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SupportCodeInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="1" Content="{Binding ConnectButton}" Style="{StaticResource Btn.Primary}"
                            Command="{Binding ConnectCommand}" Margin="8,0,0,0" MinWidth="96" Padding="14,8" MinHeight="40"/>
                </Grid>

                <StackPanel Margin="0,0,12,0"
                            Visibility="{Binding IsLanMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding LanRefreshLabel}" Style="{StaticResource Btn.Ghost}"
                                Command="{Binding RefreshLanCommand}" Padding="12,4"/>
                        <TextBlock Text="{Binding LanComputersLabel}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding LanEmptyLabel}" FontSize="12" Foreground="{StaticResource Brush.Faint}"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding LanEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <ItemsControl ItemsSource="{Binding LanPeers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Primary}" Margin="0,8,8,0" Padding="14,8" MinWidth="170"
                                        Command="{Binding DataContext.ConnectLanPeerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.85"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,10,0,0" MaxWidth="520" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid MinHeight="36">
                            <TextBox Style="{StaticResource FieldBox}" Padding="10,6" MinHeight="36" Width="360"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding LanManualAddress, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding LanManualPlaceholder}" IsHitTestVisible="False"
                                       Foreground="{StaticResource Brush.Faint}" FontSize="12"
                                       Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LanManualAddress}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="1" Content="{Binding LanConnectLabel}" Style="{StaticResource Btn.Primary}"
                                Command="{Binding ConnectLanManualCommand}" Margin="8,0,0,0" Padding="14,6" MinHeight="36"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding ConnectionStatusColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource Brush.Muted}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" FontSize="12" Margin="8,4,8,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Grid.Row="1" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0" ClipToBounds="True">
                <session:SessionView x:Name="LiveSessionView" DataContext="{Binding SessionViewModel}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
